{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": {
                    "tool_name": "Edit|Write"
                },
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/ruff_format.py\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/ruff_check.py\""
                    }
                ]
            }
        ]
    }
}
